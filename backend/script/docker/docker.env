## 宿主机端口
ADMIN_HOST_PORT=8080
SERVER_HOST_PORT=48080
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379

## MySQL 容器与后端共用的数据库配置
MYSQL_DATABASE=cps
MYSQL_ROOT_PASSWORD=admin@123
MYSQL_USER=qiji
MYSQL_PASSWORD=admin@123
MASTER_DATASOURCE_URL=jdbc:mysql://qiji-mysql:3306/${MYSQL_DATABASE}?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true&rewriteBatchedStatements=true
SLAVE_DATASOURCE_URL=${MASTER_DATASOURCE_URL}

## Redis 容器与后端共用的认证配置
REDIS_USERNAME=default
REDIS_PASSWORD=admin@123
REDIS_DATABASE=0

## Java 后端
SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-Xms512m -Xmx512m -Djava.security.egd=file:/dev/./urandom
JAVA_ARGS=

## 外部 MCP（海纳不可用时不影响 Java 包启动；API Key 请填服务器环境变量）
AI_MCP_CLIENT_ENABLED=true
AI_MCP_CLIENT_TOOLCALLBACK_ENABLED=false
HAINA_MCP_ENABLED=true
